# Hospital EMR/EHR System - Frontend Environment Configuration

# API Configuration
# Use the relative path so Vite proxies /api to the backend.
# Works from localhost, LAN IPs, and production reverse proxies.
VITE_API_URL=/api/v1
VITE_APP_NAME=Hospital EMR
VITE_APP_VERSION=1.0.0

# PWA Configuration
VITE_PWA_ENABLED=true

# Build Configuration
VITE_BUILD_TARGET=esnext

# Feature Flags (optional)
VITE_ENABLE_TELEMEDICINE=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_MULTI_LANGUAGE=false

# Analytics (optional)
VITE_ANALYTICS_ID=

# Support
VITE_SUPPORT_EMAIL=support@hospital.com
VITE_SUPPORT_PHONE=+1-555-0100
