# Hospital EMR/EHR System - Backend Environment Configuration

# Application Configuration
APP_NAME="Hospital EMR/EHR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Application Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP Configuration
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Default: SQLite (for development)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hospital_emr
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL Configuration (uncomment for production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hospital_emr
# DB_USERNAME=root
# DB_PASSWORD=your_password

# PostgreSQL Configuration (uncomment for production)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=hospital_emr
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast Configuration
BROADCAST_CONNECTION=log

# Filesystem Configuration
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached Configuration
MEMCACHED_HOST=127.0.0.1

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@hospital.com"
MAIL_FROM_NAME="${APP_NAME}"

# Amazon SES Configuration (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Authentication Configuration
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=10080

# Hospital EMR Integration
# OUTBOUND_API_KEY: credential we use when calling them.
# INBOUND_API_KEY: credential they use when calling us (create with `php artisan api-key:create`).
# WEBHOOK_SIGNING_SECRET: used to sign webhooks we send.
# WEBHOOK_VERIFY_SECRET: used to verify webhooks we receive.
HOSPITAL_EMR_BASE_URL=
HOSPITAL_EMR_OUTBOUND_API_KEY=
HOSPITAL_EMR_INBOUND_API_KEY=
HOSPITAL_EMR_WEBHOOK_SIGNING_SECRET=
HOSPITAL_EMR_WEBHOOK_VERIFY_SECRET=
HOSPITAL_EMR_WEBHOOK_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backup Configuration
BACKUP_PATH=storage/app/backups

# Installer Status
INSTALLER_COMPLETED=false

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
