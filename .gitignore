# Hospital EMR/EHR System - Git Ignore Configuration

# ================================
# Backend (.gitignore)
# ================================

# Dependencies
/backend/vendor/
/backend/node_modules/

# Environment Files
/backend/.env
/backend/.env.local

# Database Files
/backend/database/database.sqlite
/backend/database/*.sqlite

# Storage Files (uploads, backups, logs)
/backend/storage/app/uploads/*
!/backend/storage/app/uploads/.gitkeep
/backend/storage/app/backups/*
!/backend/storage/app/backups/.gitkeep
/backend/storage/logs/*
!/backend/storage/logs/.gitkeep

# Cache Files
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitkeep
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitkeep

# Log Files
/backend/storage/logs/*.log
/backend/storage/logs/*.pid

# Session Files
/backend/storage/framework/sessions/*
!/backend/framework/sessions/.gitkeep

# Compiled Files
/backend/public/build/*
/backend/public/hot

# ================================
# Frontend (.gitignore)
# ================================

# Dependencies
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.js

# Build Output
/frontend/dist/
/frontend/dist-ssr/
/frontend/build/
/frontend/out/

# Environment Files
/frontend/.env
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local

# Debug Logs
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# Editor Directories and Files
/frontend/.vscode/*
!/frontend/.vscode/extensions.json
/frontend.idea
/frontend.vs
/frontend*.swp
/frontend*.swo
/frontend*~

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

